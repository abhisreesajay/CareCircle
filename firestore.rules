rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isCaregiver() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "caregiver";
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if isOwner(userId)
        || isCaregiver();

      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        && request.resource.data.role
            == resource.data.role;

      allow delete: if false;
    }

    // ============================================================
    // SAFE ZONES
    // ============================================================

    match /safeZones/{safeZoneId} {

      // Elder can read their assigned safe zones.
      // Caregiver can read zones they created.
      allow read: if isSignedIn()
        && (
          resource.data.elderId
              == request.auth.uid
          || (
            isCaregiver()
            && resource.data.createdBy
                == request.auth.uid
          )
        );

      // Only a caregiver can create a safe zone.
      allow create: if isCaregiver()
        && request.resource.data.createdBy
            == request.auth.uid
        && request.resource.data.elderId
            is string
        && request.resource.data.elderId
            != ""
        && request.resource.data.name
            is string
        && request.resource.data.name
            != ""
        && request.resource.data.latitude
            is number
        && request.resource.data.latitude
            >= -90
        && request.resource.data.latitude
            <= 90
        && request.resource.data.longitude
            is number
        && request.resource.data.longitude
            >= -180
        && request.resource.data.longitude
            <= 180
        && request.resource.data.radiusInMeters
            is number
        && request.resource.data.radiusInMeters
            >= 50;

      // Only the caregiver who created
      // the zone can update it.
      allow update: if isCaregiver()
        && resource.data.createdBy
            == request.auth.uid
        && request.resource.data.createdBy
            == resource.data.createdBy
        && request.resource.data.elderId
            == resource.data.elderId
        && request.resource.data.name
            is string
        && request.resource.data.name
            != ""
        && request.resource.data.latitude
            is number
        && request.resource.data.latitude
            >= -90
        && request.resource.data.latitude
            <= 90
        && request.resource.data.longitude
            is number
        && request.resource.data.longitude
            >= -180
        && request.resource.data.longitude
            <= 180
        && request.resource.data.radiusInMeters
            is number
        && request.resource.data.radiusInMeters
            >= 50;

      // Only the caregiver who created
      // the zone can delete it.
      allow delete: if isCaregiver()
        && resource.data.createdBy
            == request.auth.uid;
    }

    // ============================================================
    // SAFE-ZONE VIOLATIONS
    // ============================================================

    match /safeZoneViolations/{violationId} {

      // Elder can create an OUTSIDE violation only when
      // the referenced safe zone belongs to that elder.
      allow create: if isSignedIn()
        && request.resource.data.elderId
            == request.auth.uid
        && request.resource.data.safeZoneId
            is string
        && request.resource.data.safeZoneId
            != ""
        && exists(
          /databases/$(database)/documents/safeZones/$(request.resource.data.safeZoneId)
        )
        && get(
          /databases/$(database)/documents/safeZones/$(request.resource.data.safeZoneId)
        ).data.elderId
            == request.auth.uid
        && request.resource.data.status
            == "OUTSIDE"
        && request.resource.data.latitude
            is number
        && request.resource.data.longitude
            is number
        && request.resource.data.distanceInMeters
            is number;

      // Elder can read their own violations.
      // Signed-in caregivers can read violations.
      allow read: if isSignedIn()
        && (
          resource.data.elderId
              == request.auth.uid
          || isCaregiver()
        );

      // Violations cannot be modified or deleted by clients.
      allow update, delete: if false;
    }

    // ============================================================
    // SOS
    // ============================================================

    match /sosAlerts/{sosId} {

      // Elder can create their own active SOS.
      allow create: if isSignedIn()
        && request.resource.data.userId
            == request.auth.uid
        && request.resource.data.status
            == "ACTIVE";

      // Elder can read their own SOS.
      // Caregivers can read SOS alerts.
      allow read: if isSignedIn()
        && (
          resource.data.userId
              == request.auth.uid
          || isCaregiver()
        );

      // Elder can cancel their own active SOS.
      allow update: if isSignedIn()
        && resource.data.userId
            == request.auth.uid
        && request.resource.data.userId
            == resource.data.userId
        && request.resource.data.status
            == "CANCELLED";

      allow delete: if false;
    }

    // ============================================================
    // CARE CIRCLES
    // ============================================================

    match /careCircles/{circleId} {

      allow read, create, update, delete:
          if isSignedIn();
    }

    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}