rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isCaregiver() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "caregiver";
    }

    // --------------------------------------------------
    // USERS
    // --------------------------------------------------

    match /users/{userId} {

      allow read: if isOwner(userId) || isCaregiver();

      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // --------------------------------------------------
    // SAFE ZONES
    // --------------------------------------------------

    match /safeZones/{safeZoneId} {

      allow read: if isSignedIn()
        && (
          resource.data.elderId == request.auth.uid
          || isCaregiver()
        );

      allow create: if isSignedIn()
        && request.resource.data.elderId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.elderId == request.auth.uid
        && request.resource.data.elderId == resource.data.elderId;

      allow delete: if isSignedIn()
        && resource.data.elderId == request.auth.uid;
    }

    // --------------------------------------------------
    // SOS RECORDS
    // --------------------------------------------------

    match /sosRecords/{sosId} {

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "ACTIVE";

      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isCaregiver()
        );

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status == "CANCELLED";

      allow delete: if false;
    }

    // --------------------------------------------------
    // SAFE-ZONE VIOLATIONS
    // --------------------------------------------------

    match /safeZoneViolations/{violationId} {

      allow create: if isSignedIn()
        && request.resource.data.elderId == request.auth.uid;

      allow read: if isSignedIn()
        && (
          resource.data.elderId == request.auth.uid
          || isCaregiver()
        );

      allow update, delete: if false;
    }

    // --------------------------------------------------
    // CARE CIRCLES
    // --------------------------------------------------

    match /careCircles/{circleId} {

      allow read, create, update, delete: if isSignedIn();
    }

    // --------------------------------------------------
    // DENY EVERYTHING ELSE
    // --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}