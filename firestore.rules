
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(
        /databases/$(database)/documents/users/$(uid)
      ).data;
    }

    function isCaregiver() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userData(request.auth.uid).role == 'caregiver';
    }

    function isElder() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userData(request.auth.uid).role == 'elder';
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userData(request.auth.uid).role == 'admin';
    }

    function caregiverLinkedToElder(elderId) {
      return isCaregiver()
        && userData(request.auth.uid).linkedElders is list
        && elderId in userData(request.auth.uid).linkedElders;
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // A user can read their own profile.
      // Admins can read profiles for administration.
      // Caregivers can read profiles of elders linked to them.
      allow get: if isOwner(userId)
        || isAdmin()
        || caregiverLinkedToElder(userId);

      // Only admins may list/query the entire users collection.
      allow list: if isAdmin();

      // Normal signup can create Elder or Caregiver accounts only.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['elder', 'caregiver'];

      // Normal profile updates.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'fcmToken',
              'fcmTokens',
              'fcmTokenUpdatedAt',
              'lastActive',
              'inviteCode'
            ]);


      // Admin user management.
      allow update: if isAdmin();

      // Caregiver adds their own UID to an elder's caregivers list.
      allow update: if isCaregiver()
        && resource.data.role == 'elder'
        && request.resource.data.role == 'elder'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['caregivers'])
        && request.resource.data.caregivers is list
        && request.resource.data.caregivers.hasAny([
          request.auth.uid
        ]);

      // Caregiver manages their own linkedElders list.
      allow update: if isOwner(userId)
        && resource.data.role == 'caregiver'
        && request.resource.data.role == 'caregiver'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['linkedElders'])
        && request.resource.data.linkedElders is list;

      allow delete: if false;
    }


    // ============================================================
    // INVITE CODES
    // ============================================================

    match /inviteCodes/{code} {

      // Caregivers can look up existing invite codes.
      // Elders can read only their own invite-code document.
      allow get: if isCaregiver()
        || (
          isOwner(resource.data.elderId)
          && isElder()
        );

      // Never allow listing all invite codes.
      allow list: if false;

      // Only an elder can create an invite code for themselves.
      allow create: if isElder()
        && request.resource.data.elderId == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.keys().hasOnly([
          'code',
          'elderId',
          'createdAt'
        ]);

      // Only the owning elder can update their own invite code.
      allow update: if isElder()
        && resource.data.elderId == request.auth.uid
        && request.resource.data.elderId == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.keys().hasOnly([
          'code',
          'elderId',
          'createdAt'
        ]);

      // Only the owning elder can delete their invite code.
      allow delete: if isElder()
        && resource.data.elderId == request.auth.uid;
    }


    // ============================================================
    // ELDER DATA
    // ============================================================

    match /elders/{elderId} {

      allow read: if isOwner(elderId)
        || caregiverLinkedToElder(elderId);

      allow create: if isOwner(elderId);

      // Only the elder account owner can update
      // the main elder document.
      allow update: if isOwner(elderId);

      allow delete: if false;


      // ==========================================================
      // MEDICINES
      // ==========================================================

      match /medicines/{medicineId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // APPOINTMENTS
      // ==========================================================

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // EMERGENCY CONTACTS
      // ==========================================================

      match /emergencyContacts/{contactId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // NEARBY SERVICES
      // ==========================================================

      match /nearbyServices/{serviceId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // MEDICAL SUMMARY
      // ==========================================================

      match /medicalSummary/{summaryId} {

        allow read: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);

        allow create, update: if caregiverLinkedToElder(elderId);

        allow delete: if false;
      }


      // ==========================================================
      // DAILY CHECK-INS
      // ==========================================================

      match /checkIns/{checkInId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }

      // ==========================================================
      // CHECK-IN HISTORY
      // ==========================================================

      match /checkInHistory/{checkInId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }

      // ==========================================================
      // CHECK-IN REMINDERS
      // ==========================================================

      match /checkInReminders/{reminderId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // ACTIVITY HISTORY
      // ==========================================================

      match /activityHistory/{activityId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // STATUS
      // ==========================================================

      match /status/{statusId} {
        allow read, write: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // ELDER ALERTS
      // ==========================================================

      match /alerts/{alertId} {

        allow read: if isOwner(elderId)
          || caregiverLinkedToElder(elderId)
          || isAdmin();

        // Supports AlertService and SafeZoneService alert creation.
        allow create: if (
            isOwner(elderId)
            || caregiverLinkedToElder(elderId)
          )
          && request.resource.data.elderId == elderId
          && request.resource.data.status == 'active';

        // Supports SOS cancellation and admin resolution.
        allow update: if (
            isOwner(elderId)
            || caregiverLinkedToElder(elderId)
            || isAdmin()
          )
          && request.resource.data.elderId == resource.data.elderId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'message',
                'cancelledAt',
                'resolvedAt',
                'resolvedBy'
              ]);

        // Supports AlertService.deleteAlert for the elder
        // and linked caregivers.
        allow delete: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // HOSPITAL DOCUMENTS
      // ==========================================================

      match /hospitalDocuments/{documentId} {

        allow read: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);

        allow create, update, delete:
          if caregiverLinkedToElder(elderId);
      }
    }


    // ============================================================
    // SAFE ZONES
    // ============================================================

    match /safeZones/{safeZoneId} {

      // Elders can read their own zones.
      // Linked caregivers and admins can also read them.
      allow get, list: if signedIn()
        && (
          resource.data.elderId == request.auth.uid
          || caregiverLinkedToElder(resource.data.elderId)
          || isAdmin()
        );

      // Only a linked caregiver can create a safe zone.
      allow create: if isCaregiver()
        && request.resource.data.elderId is string
        && caregiverLinkedToElder(request.resource.data.elderId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radiusInMeters is number
        && request.resource.data.radiusInMeters > 0;

      // Only the caregiver who created the zone can edit it.
      allow update: if isCaregiver()
        && resource.data.createdBy == request.auth.uid
        && caregiverLinkedToElder(resource.data.elderId)
        && request.resource.data.elderId == resource.data.elderId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'latitude',
              'longitude',
              'radiusInMeters'
            ])
        && request.resource.data.name is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radiusInMeters is number
        && request.resource.data.radiusInMeters > 0;

      // Only the caregiver who created the zone can delete it.
      allow delete: if isCaregiver()
        && resource.data.createdBy == request.auth.uid
        && caregiverLinkedToElder(resource.data.elderId);
    }

    // ============================================================
    // SAFE ZONE VIOLATIONS
    // ============================================================

        
    match /safeZoneViolations/{violationId} {

      function canAccessElder(elderId) {
        return signedIn()
          && (
            request.auth.uid == elderId
            || caregiverLinkedToElder(elderId)
            || isAdmin()
          );
      }

      allow get, list: if canAccessElder(resource.data.elderId);

      allow create: if request.resource.data.elderId is string
        && canAccessElder(request.resource.data.elderId)
        && request.resource.data.safeZoneId is string
        && request.resource.data.status == 'OUTSIDE';

      allow update: if canAccessElder(resource.data.elderId)
        && request.resource.data.elderId == resource.data.elderId
        && request.resource.data.safeZoneId == resource.data.safeZoneId
        && (
          // Update an active outside violation.
          (
            resource.data.status == 'OUTSIDE'
            && request.resource.data.status == 'OUTSIDE'
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'latitude',
                'longitude',
                'distanceInMeters',
                'lastCheckedAt'
              ])
          )
          ||
          // Resolve an outside violation.
          (
            resource.data.status == 'OUTSIDE'
            && request.resource.data.status == 'SAFE'
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'resolvedAt',
                'lastCheckedAt'
              ])
          )
          ||
          // Reopen a resolved violation.
          (
            resource.data.status == 'SAFE'
            && request.resource.data.status == 'OUTSIDE'
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'violationId',
                'safeZoneName',
                'latitude',
                'longitude',
                'zoneLatitude',
                'zoneLongitude',
                'distanceInMeters',
                'timestamp',
                'status',
                'createdAt',
                'lastCheckedAt',
                'resolvedAt'
              ])
          )
        );

      allow delete: if false;
    }


    // ============================================================
    // SOS ALERTS
    // ============================================================

    match /sosAlerts/{sosId} {

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'ACTIVE';

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || (
            isCaregiver()
            && userData(request.auth.uid).linkedElders is list
            && resource.data.userId
                in userData(request.auth.uid).linkedElders
          )
          || isAdmin()
        );

      allow update: if
        // Owner cancels their own active SOS.
        (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && resource.data.status == 'ACTIVE'
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'cancelledAt'])
        )
        ||
        // Admin resolves an active SOS.
        (
          isAdmin()
          && resource.data.status == 'ACTIVE'
          && request.resource.data.status == 'RESOLVED'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'resolvedAt',
                'resolvedBy'
              ])
          && request.resource.data.resolvedBy == 'admin'
        );

      allow delete: if false;
    }


    // ============================================================
    // PLATFORM-WIDE ALERTS
    // ============================================================

    match /alerts/{alertId} {

      allow read: if isAdmin();

      allow create: if signedIn();

      allow update: if isAdmin();

      allow delete: if false;
    }


    // ============================================================
    // MEDICAL INFORMATION
    // ============================================================

    match /medicalInformation/{elderId} {

      allow read, write: if isOwner(elderId)
        || caregiverLinkedToElder(elderId);
    }


    // ============================================================
    // COLLECTION-GROUP ALERTS
    // ============================================================

    match /{path=**}/alerts/{alertId} {
      allow get, list: if isAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}