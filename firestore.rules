rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(
        /databases/$(database)/documents/users/$(uid)
      ).data;
    }

    function isCaregiver() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userData(request.auth.uid).role == 'caregiver';
    }

    function isElder() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userData(request.auth.uid).role == 'elder';
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userData(request.auth.uid).role == 'admin';
    }

    function caregiverLinkedToElder(elderId) {
      return isCaregiver()
        && userData(request.auth.uid).linkedElders is list
        && elderId in userData(request.auth.uid).linkedElders;
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // Owner can read their own profile.
      // Caregivers can read users for existing app functionality.
      // Admins can read all users.
      allow read: if isOwner(userId)
        || isCaregiver()
        || isAdmin();


      // Public signup may create only Elder or Caregiver accounts.
      // Admin accounts must NOT be created through normal signup.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['elder', 'caregiver'];


      // Normal users can update their own profile,
      // but they cannot change their role.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;


      // Admin can manage user profiles and roles.
      allow update: if isAdmin();


      // Caregiver adding themselves to an elder.
      allow update: if signedIn()
        && resource.data.role == 'elder'
        && request.resource.data.role == 'elder'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['caregivers'])
        && request.resource.data.caregivers is list
        && request.resource.data.caregivers
            .hasAny([request.auth.uid]);


      // Caregiver linked elder list.
      allow update: if isOwner(userId)
        && resource.data.role == 'caregiver'
        && request.resource.data.role == 'caregiver'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['linkedElders'])
        && request.resource.data.linkedElders is list;

      allow delete: if false;
    }


    // ============================================================
    // INVITE CODES
    // ============================================================

    match /inviteCodes/{code} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.elderId
            == request.auth.uid
        && request.resource.data.code
            == code;

      allow update: if signedIn()
        && resource.data.elderId
            == request.auth.uid
        && request.resource.data.elderId
            == request.auth.uid
        && request.resource.data.code
            == code;

      allow delete: if signedIn()
        && resource.data.elderId
            == request.auth.uid;
    }


    // ============================================================
    // ELDER DATA
    // ============================================================

    match /elders/{elderId} {

      allow read: if isOwner(elderId)
        || caregiverLinkedToElder(elderId);

      allow create: if isOwner(elderId);

      allow update: if isOwner(elderId)
        || caregiverLinkedToElder(elderId);

      allow delete: if false;


      // ==========================================================
      // MEDICINES
      // ==========================================================

      match /medicines/{medicineId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // APPOINTMENTS
      // ==========================================================

      match /appointments/{appointmentId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // EMERGENCY CONTACTS
      // ==========================================================

      match /emergencyContacts/{contactId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // NEARBY SERVICES
      // ==========================================================

      match /nearbyServices/{serviceId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // MEDICAL SUMMARY
      // ==========================================================

      match /medicalSummary/{summaryId} {

        allow read:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);

        allow create, update:
          if caregiverLinkedToElder(elderId);

        allow delete: if false;
      }


      // ==========================================================
      // CHECK-IN HISTORY
      // ==========================================================

      match /checkInHistory/{checkInId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // ACTIVITY HISTORY
      // ==========================================================

      match /activityHistory/{activityId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // STATUS
      // ==========================================================

      match /status/{statusId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // ELDER ALERTS
      // ==========================================================

      match /alerts/{alertId} {
        allow read, write:
          if isOwner(elderId)
          || caregiverLinkedToElder(elderId);
      }


      // ==========================================================
      // HOSPITAL DOCUMENTS
      // ==========================================================

      match /hospitalDocuments/{documentId} {

        allow read: if isOwner(elderId)
          || caregiverLinkedToElder(elderId);

        allow create: if caregiverLinkedToElder(elderId);

        allow update: if caregiverLinkedToElder(elderId);

        allow delete: if caregiverLinkedToElder(elderId);
      }
    }


    // ============================================================
    // SAFE ZONES
    // ============================================================

    match /safeZones/{safeZoneId} {

      allow read: if signedIn()
        && (
          resource.data.elderId == request.auth.uid
          ||
          (
            isCaregiver()
            && caregiverLinkedToElder(
              resource.data.elderId
            )
          )
          ||
          isAdmin()
        );

      allow create: if isCaregiver()
        && caregiverLinkedToElder(
          request.resource.data.elderId
        )
        && request.resource.data.createdBy
            == request.auth.uid;

      allow update: if isCaregiver()
        && resource.data.createdBy
            == request.auth.uid
        && caregiverLinkedToElder(
          resource.data.elderId
        );

      allow delete: if isCaregiver()
        && resource.data.createdBy
            == request.auth.uid;
    }


    // ============================================================
    // SAFE ZONE VIOLATIONS
    // ============================================================

    match /safeZoneViolations/{violationId} {

      allow create: if signedIn()
        && request.resource.data.elderId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.elderId == request.auth.uid
          ||
          caregiverLinkedToElder(
            resource.data.elderId
          )
          ||
          isAdmin()
        );

      allow update, delete: if false;
    }


    // ============================================================
    // SOS ALERTS
    // ============================================================

    match /sosAlerts/{sosId} {

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'ACTIVE';

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          ||
          (
            isCaregiver()
            && userData(request.auth.uid).linkedElders is list
            && resource.data.userId
                in userData(request.auth.uid).linkedElders
          )
          ||
          isAdmin()
        );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'CANCELLED';

      allow delete: if false;
    }


    // ============================================================
    // CARE CIRCLES
    // ============================================================

    match /careCircles/{circleId} {

      allow read, create, update, delete:
        if signedIn();
    }


    // ============================================================
    // ADMIN CARE CIRCLE COLLECTION
    // ============================================================

    match /care_circles/{circleId} {

      allow read: if isAdmin();

      allow create, update, delete:
        if isAdmin();
    }


    // ============================================================
    // PLATFORM-WIDE ALERTS
    // ============================================================

    match /alerts/{alertId} {

      // Admin dashboard can view platform-wide alerts.
      allow read: if isAdmin();

      // Existing application users may create alerts
      // only when the application writes them.
      allow create: if signedIn();

      // Only admins can directly modify platform-wide alerts.
      allow update: if isAdmin();

      allow delete: if false;
    }


    // ============================================================
    // MEDICAL INFORMATION
    // ============================================================

    match /medicalInformation/{elderId} {

      allow read, write:
        if isOwner(elderId)
        || caregiverLinkedToElder(elderId);
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}